              return Padding(
                padding: EdgeInsets.only(bottom: row < cellCount - 1 ? 8 : 0),
                child: Row(
                  children: cols.map((col) {
                    final index = row * cellCount + col;
                    return Padding(
                      padding: EdgeInsets.only(right: col < cols.last ? 8 : 0),
                      child: Container(
                        width: cellSize,
